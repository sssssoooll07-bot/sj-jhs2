rules_version = '2';

// Firestore — 접근 관리 목록(config/access): 로그인 사용자는 읽기(자기 열람 범위 확인용), 쓰기는 소유자만.
// (Storage 규칙은 firestore.get으로 서버측에서 이 문서를 읽으므로 클라이언트 규칙과 무관하게 동작한다.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /config/access {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == 'sssssoooll07@gmail.com';
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
