rules_version = '2';

// Firebase Storage 보안 규칙 — 허용된 계정만 접근.
// 문서 폴더는 {allPaths=**}로 매칭해 목록(list) 조회도 허용한다.
service firebase.storage {
  match /b/{bucket}/o {
    // 허용된 계정만 접근 (Google 로그인은 아무 계정이나 로그인되므로 이메일로 제한)
    function allowed() {
      return request.auth != null && request.auth.token.email in [
        'sssssoooll07@gmail.com'
      ];
    }
    // 마스터 엑셀
    match /master/{fileName} {
      allow read, write: if allowed() && fileName.matches('.*[.]xlsx');
    }
    // 협약서
    match /agreements/{allPaths=**} {
      allow read, write: if allowed();
    }
    // 특허증
    match /patents/{allPaths=**} {
      allow read, write: if allowed();
    }
    // 통장거래내역
    match /bankbook/{allPaths=**} {
      allow read, write: if allowed();
    }
    // 사업계획서
    match /businessplans/{allPaths=**} {
      allow read, write: if allowed();
    }
    // 자료실 문서
    match /refdocs/{allPaths=**} {
      allow read, write: if allowed();
    }
    // 사업비 정산 양식·파일
    match /budgets/{allPaths=**} {
      allow read, write: if allowed();
    }
    // 그 외 경로는 전면 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
