rules_version = '2';

// Firebase Storage 보안 규칙
// - 소유자(sssssoooll07): 전체 읽기+쓰기
// - 보기 전용 뷰어: 커스텀 클레임 viewer==true (접근 관리 목록 → Auth 클레임 동기화)
//   · 열람 범위 scopes(섹션키 배열, "*"=전체) → 문서 폴더 읽기 제한
//   · 수정 범위 editScopes(섹션키 배열) → 문서 폴더 쓰기 + (하나라도 있으면) 마스터 쓰기
//   · (firebasestorage.app 버킷은 규칙의 cross-service firestore.get이 동작하지 않아 클레임 사용)
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'sssssoooll07@gmail.com';
    }
    function isViewer() {
      return request.auth != null && request.auth.token.viewer == true;
    }
    function canRead() { return isOwner() || isViewer(); }
    function viewerScopes() { return request.auth.token.get('scopes', ['*']); }
    function viewerEdits() { return request.auth.token.get('editScopes', []); }
    function scopeAllows(section) {
      return isOwner() || ( isViewer() && ( ('*' in viewerScopes()) || (section in viewerScopes()) ) );
    }
    function editAllows(section) {
      return isOwner() || ( isViewer() && ( ('*' in viewerEdits()) || (section in viewerEdits()) ) );
    }
    // 마스터(전 데이터 1파일)는 섹션 격리 불가 → 수정 권한이 하나라도 있으면 쓰기 허용
    function canWriteData() { return isOwner() || ( isViewer() && viewerEdits().size() > 0 ); }

    // 마스터 엑셀 — 읽기: 소유자·뷰어 / 쓰기: 소유자 또는 수정권한 보유 뷰어
    match /master/{fileName} {
      allow read: if canRead() && fileName.matches('.*[.]xlsx');
      allow write: if canWriteData() && fileName.matches('.*[.]xlsx');
    }
    // 문서 폴더 — 읽기: 열람범위 / 쓰기: 수정범위
    match /agreements/{allPaths=**}    { allow read: if scopeAllows('projects');       allow write: if editAllows('projects'); }
    match /bankbook/{allPaths=**}      { allow read: if scopeAllows('projects');       allow write: if editAllows('projects'); }
    match /businessplans/{allPaths=**} { allow read: if scopeAllows('projects');       allow write: if editAllows('projects'); }
    match /researchnotes/{allPaths=**} { allow read: if scopeAllows('projects');       allow write: if editAllows('projects'); }
    match /patents/{allPaths=**}       { allow read: if scopeAllows('patents');        allow write: if editAllows('patents'); }
    match /budgets/{allPaths=**}       { allow read: if scopeAllows('budget');         allow write: if editAllows('budget'); }
    match /certs/{allPaths=**}         { allow read: if scopeAllows('certifications'); allow write: if editAllows('certifications'); }
    match /refdocs/{allPaths=**}       { allow read: if scopeAllows('library');        allow write: if editAllows('library'); }

    // 그 외 경로는 전면 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
