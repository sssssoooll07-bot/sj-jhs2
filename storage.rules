rules_version = '2';

// Firebase Storage 보안 규칙
// - 소유자(sssssoooll07): 읽기+쓰기(편집)
// - 접근 관리(Firestore config/access.viewers)에 등록된 이메일: 읽기 전용
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'sssssoooll07@gmail.com';
    }
    // 접근 관리 페이지에서 등록한 보기 전용 계정 (Firestore config/access 문서)
    function isViewer() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/config/access)
        && request.auth.token.email in firestore.get(/databases/(default)/documents/config/access).data.viewers;
    }
    function canRead() { return isOwner() || isViewer(); }

    // 마스터 엑셀 — 읽기: 소유자·뷰어 / 쓰기: 소유자만
    match /master/{fileName} {
      allow read: if canRead() && fileName.matches('.*[.]xlsx');
      allow write: if isOwner() && fileName.matches('.*[.]xlsx');
    }
    // 문서 폴더 — 읽기: 소유자·뷰어 / 쓰기: 소유자만
    match /agreements/{allPaths=**}    { allow read: if canRead(); allow write: if isOwner(); }
    match /patents/{allPaths=**}       { allow read: if canRead(); allow write: if isOwner(); }
    match /bankbook/{allPaths=**}      { allow read: if canRead(); allow write: if isOwner(); }
    match /businessplans/{allPaths=**} { allow read: if canRead(); allow write: if isOwner(); }
    match /refdocs/{allPaths=**}       { allow read: if canRead(); allow write: if isOwner(); }
    match /budgets/{allPaths=**}       { allow read: if canRead(); allow write: if isOwner(); }
    match /researchnotes/{allPaths=**} { allow read: if canRead(); allow write: if isOwner(); }
    match /certs/{allPaths=**}         { allow read: if canRead(); allow write: if isOwner(); }

    // 그 외 경로는 전면 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
